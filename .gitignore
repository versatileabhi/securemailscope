# SecureMailScope — .gitignore

# Virtual environments
.venv/
venv/
env/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Pytest
.pytest_cache/

# Mypy
.mypy_cache/

# Ruff
.ruff_cache/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
WHEEL
MANIFEST

# Environment files
.env
.env.*
!.env.example

# Runtime data (local only — never commit)
runtime/*
!runtime/README.md
!runtime/**/.gitkeep

# Raw and processed data (local only)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Samples (local only)
samples/*
!samples/README.md
!samples/.gitkeep

# Local ML models (local only)
models/*
!models/README.md
!models/.gitkeep

# Packet captures (NEVER commit)
*.pcap
*.pcapng
*.cap
*.pcap.gz
*.pcap.bz2

# Certificates and keys (NEVER commit)
*.key
*.pem
*.crt
*.cer
*.p12
*.pfx
*.p7b
*.der

# Log files
*.log

# Databases
*.sqlite
*.sqlite3
*.db

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docobj

# Jupyter
.ipynb_checkpoints/
